# Copy this file to .env and fill in what you need. Every line is optional:
# with none of them set the app runs fully offline, and the first time you
# open /login it asks you to create the administrator account.
#
# .env is in .gitignore. Keep it that way -- it holds your keys.

# --- Translation and speech (optional) -------------------------------------
# Without a key the offline engine handles every request on its own. Adding a
# key turns on real translation and server-side voice transcription.
# GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Staff accounts --------------------------------------------------------
# Normally you do not set these: open /login and create the administrator
# there. They exist for unattended deployments, where nobody is at a browser
# to complete the setup screen.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-something-real

# --- Server ----------------------------------------------------------------
# PORT=8000
# APP_DB=data.db
# SESSION_HOURS=12
